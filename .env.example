# Server only. Use an absolute path OUTSIDE frontend/ and outside public Git.
MOF_MODEL_PATH=/tmp/mof-private/model.onnx
# Expected frozen ONNX model. Retrained artifacts must set their own hash.
MOF_MODEL_SHA256=5b7f0f9cf570a24b677763afb59bd0f58889c9eba0feb0d26eafaf97c72d316f
# Optional private HTTPS artifact endpoint, used by download_private_model.py.
MOF_MODEL_URL=
MOF_MODEL_BEARER_TOKEN=
# Exact Netlify site origin, comma-separated if needed; not a wildcard.
MOF_ALLOWED_ORIGINS=
MOF_MAX_ATOMS=200
MOF_REQUESTS_PER_MINUTE=60
